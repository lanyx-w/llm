      "enabled": true
    },
    "anythingllm": {
      "type": "local",
      "command": ["anythingllm-mcp"],
      "enabled": true,
      "environment": {
        "ANYTHINGLLM_ENV_FILE": "D:/AI/anythingllm-mcp/.env"
      }
    }
  }
}
